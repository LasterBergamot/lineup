{
  "components": {
    "schemas": {
      "FileFormat": {
        "description": "Output format of a generated lineup, taken from the `format` query parameter.",
        "enum": [
          "pdf",
          "docx"
        ],
        "title": "FileFormat",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Body of the health endpoint: `ok`, or `unavailable` when the database check failed.",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LineupRequest": {
        "description": "Everything needed to fill one lineup sheet (no database involved).\n\nText fields are trimmed, must not be empty and have a maximum length. `players` holds 1 to 15\nentries with unique cap numbers (1-15) and unique NSSZ numbers.",
        "properties": {
          "assistant_coach": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Assistant Coach",
            "type": "string"
          },
          "ball_thrower": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Ball Thrower",
            "type": "string"
          },
          "cap": {
            "enum": [
              "Fehér",
              "Kék"
            ],
            "title": "Cap",
            "type": "string"
          },
          "coach": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Coach",
            "type": "string"
          },
          "date": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Date",
            "type": "string"
          },
          "division": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Division",
            "type": "string"
          },
          "doctor": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Doctor",
            "type": "string"
          },
          "match": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Match",
            "type": "string"
          },
          "players": {
            "items": {
              "$ref": "#/components/schemas/PlayerRequest"
            },
            "maxItems": 15,
            "minItems": 1,
            "title": "Players",
            "type": "array"
          },
          "team_leader": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Team Leader",
            "type": "string"
          },
          "team_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Team Name",
            "type": "string"
          }
        },
        "required": [
          "match",
          "division",
          "team_name",
          "cap",
          "date",
          "coach",
          "doctor",
          "assistant_coach",
          "team_leader",
          "ball_thrower",
          "players"
        ],
        "title": "LineupRequest",
        "type": "object"
      },
