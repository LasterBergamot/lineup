  "info": {
    "description": "Generates water polo lineup documents.",
    "title": "Lineup API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness by default; `?db=1` adds a `SELECT 1` readiness probe.\n\nA failing probe returns a plain 503 body instead of raising, so the driver's error\ntext (which can contain hostnames) never reaches the client and health checks don't\nflood Sentry.",
        "operationId": "health_health_get",
        "parameters": [
          {
            "description": "Also check the database (readiness). Default: liveness only.",
            "in": "query",
            "name": "db",
            "required": false,
            "schema": {
              "default": false,
              "description": "Also check the database (readiness). Default: liveness only.",
              "title": "Db",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Database unreachable"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/lineups": {
      "post": {
        "description": "Generate a lineup sheet from the request body and return it as a file download.\n\n`format=pdf` (default) converts through LibreOffice, which only exists in the container;\n`format=docx` returns the filled template directly. Nothing is stored.",
        "operationId": "create_lineup_lineups_post",
        "parameters": [
          {
            "description": "Output format of the generated file",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/FileFormat",
              "default": "pdf",
              "description": "Output format of the generated file"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LineupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
