              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Opponent Name"
          },
          "players": {
            "items": {
              "$ref": "#/components/schemas/SavedLineupPlayerCreate"
            },
            "maxItems": 15,
            "minItems": 1,
