# Copy to frontend/.env (git-ignored). Everything prefixed VITE_ is bundled into the public
# JavaScript, so it must be safe for anyone to read: never put a secret key here.

# Base URL of the Lineup API. Leave empty in local dev to use the Vite proxy (/api -> VITE_DEV_API_TARGET).
VITE_API_URL=

# Where the dev-server proxy forwards /api to (the API container from `task up`).
VITE_DEV_API_TARGET=http://localhost:8000

# Show the "server is waking up" banner (free-tier hosting scales the API to zero).
VITE_COLD_START_NOTICE=true

# Google sign-in (Supabase Auth). Sign-in only: all data goes through the Lineup API, never the Data API.
# Project URL and the PUBLISHABLE (anon) key from Supabase -> Project Settings -> API. Never put the
# secret/service_role key here: it would ship to every browser (the app refuses to use one).
# For a local check without Google, scripts/smoke_auth.py serves a stand-in at http://127.0.0.1:<port>.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
