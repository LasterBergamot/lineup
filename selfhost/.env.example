# Settings of the self-hosted Lineup stack (selfhost/compose.yml). Every value below is a fake
# example. `lineup.sh install` writes the real `.env` next to this file with generated secrets and
# sets its permissions to 600; you do not copy this file by hand. The real file is git-ignored.
#
# Keep passwords URL-safe (letters and digits only): two of them are placed inside connection URLs.

# Which release to run: a tag such as v0.2.0. `lineup.sh update` changes this line.
LINEUP_VERSION=v0.0.0

# The public address of the install, no trailing slash. It is the sign-in issuer and the base of
# invitation links, so it must be exactly what the browser shows.
PUBLIC_URL=https://lineup.example.com

# Start the Cloudflare Tunnel with the stack. Tests leave this unset so no tunnel is needed.
COMPOSE_PROFILES=tunnel
# The tunnel token from the Cloudflare dashboard (Networks, Tunnels). Only the token, not the command.
TUNNEL_TOKEN=example-tunnel-token

# Database passwords. POSTGRES_PASSWORD is the superuser (used by `db`, `migrate` and the backup);
# AUTH_DB_PASSWORD belongs to Auth's own role; LINEUP_APP_PASSWORD to the API's least-privilege role.
POSTGRES_PASSWORD=example-postgres-password
AUTH_DB_PASSWORD=example-auth-db-password
LINEUP_APP_PASSWORD=example-app-password

# Sign-in (Supabase Auth). AUTH_JWT_SECRET is required by Auth but unused for tokens, which are
# signed with the ES256 key below. AUTH_JWT_KEYS is the JSON array printed by
# `python -m lineup.auth.signing_key`; keep it on one line and in SINGLE quotes.
AUTH_JWT_SECRET=example-jwt-secret
AUTH_JWT_KEYS='[{"kty":"EC","crv":"P-256","x":"example","y":"example","d":"example","kid":"example","alg":"ES256","use":"sig","key_ops":["sign","verify"]}]'

# Google sign-in (Google Cloud console, Clients). Only accounts on the project's test-user list can sign in.
GOOGLE_CLIENT_ID=example-client-id.apps.googleusercontent.com
GOOGLE_SECRET=example-google-secret

# Password sign-in. Leave false in a real install (Google only). The CI test stack sets true so it can
# get real tokens without Google.
AUTH_EMAIL_ENABLED=false
