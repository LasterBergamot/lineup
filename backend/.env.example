# Copy to `.env` (git-ignored) and uncomment what you need. Never commit real credentials.
# Everything here is optional: with no `.env`, the app uses local SQLite.
#
# How `.env` gets loaded:
#   - `task up` (Docker Compose): loaded automatically and passed into the container.
#   - `task serve`: sources it (so URLs below must stay double-quoted: an unquoted `&`
#     would break `source`).
#   - `task migrate` / `task migrate-new`: deliberately NOT loaded; they use SQLite unless
#     you pass DATABASE_URL for that single run.
#   - `task db:postgres` / `task db:sqlite` switch between the Supabase pooler and SQLite
#     by commenting/uncommenting the filled-in pooler line below; `task db:status` shows
#     which is active. Fill in the pooler line (not the <placeholders> one) first.
#
# Use an alphanumeric-only database password. Special characters must be URL-encoded in
# the URL, and a `%` in it additionally breaks Alembic's config parsing.

# --- DATABASE_URL -----------------------------------------------------------
# Default (what the app uses when this is unset): file-backed local SQLite.
# To switch back from Supabase to local SQLite, run `task db:sqlite` (or comment out the
# Postgres lines below by hand, or delete `.env`) and restart.
# DATABASE_URL="sqlite+aiosqlite:///./lineup.db"

# App runtime -> Supabase TRANSACTION POOLER (port 6543, user `postgres.<project-ref>`).
# The app turns prepared statements off in code (the transaction pooler does not
# support them), so only `ssl=require` is needed here (Supabase enforces TLS).
# The app uses the pooler (not the direct connection) because the direct host is IPv6-only
# and the app opens a fresh connection per request, which is cheap via the pooler but
# wasteful directly against Postgres. Also run `chmod 600 .env` once you've filled it in.
# DATABASE_URL="postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?ssl=require"

# The pooler line above should use the least-privilege `lineup_app` role, not the owner:
# after `task migrate:supabase` has applied the RLS migration, run `task db:create-app-role`
# and it rewrites this line to `lineup_app.<project-ref>` with a generated password (never
# printed). The owner (`postgres.<project-ref>`) bypasses RLS and can drop tables, so the API
# shouldn't run as it.

# Alembic migrations -> DIRECT connection (port 5432) as the table owner. The transaction
# pooler can't run the DDL/advisory-lock operations Alembic needs. These credentials live in a
# SEPARATE git-ignored file, backend/.env.migrate, never in `.env`: Docker Compose and
# `task serve` load `.env` into the API's environment, and the API must not see the owner's
# password. Create it (chmod 600) with one line:
#   MIGRATE_DATABASE_URL="postgresql+asyncpg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?ssl=require"
# (the plain `postgresql://` form from the Supabase dashboard works too: it is rewritten to the
# asyncpg driver for migrations) then run `task migrate:supabase`. The direct host is IPv6-only. If your network has no
# IPv6, use Supabase's SESSION-mode pooler instead (same pooler host and user as above, but
# port 5432) — it supports DDL:
#   MIGRATE_DATABASE_URL="postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require"
# `task migrate` (SQLite by default) ignores this file, so a plain migrate never reaches
# Supabase by accident.

# --- ENV --------------------------------------------------------------------
# `production` means "the schema is managed by Alembic; skip Base.metadata.create_all
# on startup" — NOT "this is the prod deployment". Set it whenever DATABASE_URL
# points at any real Postgres/Supabase instance (dev or prod) — it is the correct value
# for the dev database too. Unset, the app would create untracked tables itself and the
# next `task migrate` would fail with "table already exists".
# ENV=production

# --- CORS_ORIGINS -----------------------------------------------------------
# Comma-separated browser origins allowed to call the API, e.g. the Vite dev server and the
# deployed frontend. Unset/empty = no CORS headers at all (fine for curl, the one-off
# requests and same-origin use). A wildcard `*` is refused at startup on purpose.
# CORS_ORIGINS="http://localhost:5173,https://lineup-dev.pages.dev"

# --- PDF_MAX_CONCURRENT ----------------------------------------------------
# How many LibreOffice conversions may run at once (default 2). Each one is a separate
# process of a few hundred MB, so this protects a small machine. A request that can't get
# a slot within 10 s is answered with 503 + Retry-After. Must be at least 1.
# PDF_MAX_CONCURRENT=2

# --- SENTRY_DSN -------------------------------------------------------------
# Error monitoring. Leave blank/unset locally, in CI and in tests: unset means
# sentry_sdk.init() is never called and nothing is sent anywhere.
# SENTRY_DSN=
