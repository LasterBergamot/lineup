# The image only needs the app code, the template, Alembic and the lockfile.
# Anything else is either secret (.env), stale local state (*.db) or noise.

# Secrets and local state: never bake these into an image layer
.env
.env.*
*.db

# VCS, tooling, caches (the build context is backend/, so repo-root dirs like .github never reach it)
.git
.idea
.venv
__pycache__
*.pyc
.coverage
.pytest_cache
.ruff_cache

# Tests and markdown (the e2e suite runs from the host against the container)
tests/
*.md
